<Project Sdk="Microsoft.NET.Sdk">

  <!-- The level-instance binding: every aver_levelinst_* export of level_instance_abi.h, the game-author-facing
       LevelInstances API on top of them, and the seam the AN_SpawnLevelInstance family of Aver Node nodes call.

       A LEAF, like Aver.Prefab: it references nothing, because placing a level is a string and some numbers in,
       an entity handle out. The native library is Aver.LevelInstance.Abi, a different file name from this
       assembly, so no NativeResolver is needed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Aver.LevelInstance</AssemblyName>
    <RootNamespace>Aver.LevelInstance</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
